# Server Configuration
PORT=3000

# MongoDB Connection String (Atlas or Local MongoDB)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/pet_grooming?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/pet_grooming?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Optional: Clerk Authentication / Google SSO Integration
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_FRONTEND_API=your-app.clerk.accounts.dev
